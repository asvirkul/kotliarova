{
  "name": "kotliarova-main",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass scss/main.scss css/main.css --no-source-map",
    "build:js": "esbuild js/src/main.js --bundle --minify --outfile=js/main.js",
    "dev": "sass --watch scss/main.scss:css/main.css"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.77.8"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "swiper": "^14.2.0"
  }
}
